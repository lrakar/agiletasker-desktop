{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgileTasker",
  "version": "0.1.0",
  "identifier": "com.agiletasker.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/daemon-deps/**/*"],
    "externalBin": ["binaries/node"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMTg1MDNFQzY2N0ZEMkUKUldRdS9XZkdQbEFZd052MFRvWklGS1F1WHRHZXB2amY3c2p4cEZSSWFOR1VlTXBnTzVmZWI3a2wK",
      "endpoints": [
        "https://github.com/lrakar/agiletasker-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
